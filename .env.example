# Email Configuration
EMAIL_PROVIDER=zeptomail-smtp
SENDER_EMAIL=your-sender@yourdomain.com

# ZeptoMail Configuration (Works for both SMTP and API)
ZEPTOMAIL_API_KEY=your-zeptomail-api-key

# ZeptoMail SMTP Configuration (Optional - uses defaults)
ZEPTOMAIL_SMTP_USERNAME=emailapikey
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.com
ZEPTOMAIL_SMTP_PORT=587

# Alternative: ZeptoMail API Configuration
# EMAIL_PROVIDER=zeptomail

# Alternative: SendGrid Configuration
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# Alternative: Resend Configuration
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-resend-api-key

# Database
DATABASE_URI=mongodb://localhost:27017/church-management

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d

# Other configurations...